# FastAPI
FASTAPI_ENV=development
DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Groq API (primary LLM — free tier)
GROQ_API_KEY=your_groq_key_here

# Gemini API (fallback LLM, used if Groq is rate-limited)
GEMINI_API_KEY=your_gemini_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
EXTRACTION_CONCURRENCY=4
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_ALLOW_FALLBACK=true

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docugraph_chunks
STORAGE_TIMEOUT_SECONDS=2

# Ingestion (Phase 2)
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# Frontend (set once frontend exists — Phase 6)
REACT_APP_API_URL=http://localhost:8000
